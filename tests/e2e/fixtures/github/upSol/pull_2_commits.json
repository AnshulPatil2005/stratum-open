[{"sha":"8f2111f80dcbda34b409f893475b0715cfb2a1b5","node_id":"C_kwDOSrdCyNoAKDhmMjExMWY4MGRjYmRhMzRiNDA5Zjg5MzQ3NWIwNzE1Y2ZiMmExYjU","commit":{"author":{"name":"buttercup-07","email":"golechhadiksha@gmail.com","date":"2026-10-26T04:58:41Z"},"committer":{"name":"buttercup-07","email":"golechhadiksha@gmail.com","date":"2026-10-26T04:58:41Z"},"message":"Persist AI settings and improve language detection\n\nCarries over local work-in-progress from main:\n- Save provider, model, API keys and Ollama URL in chrome.storage.local\n  and restore them when the popup opens.\n- Detect the submission language from the source code when the status\n  row and page text do not expose it.\n- Show a clearer error when Gemini returns 503.\n- Rebuild dist.\n\nCo-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>","tree":{"sha":"2c809d90e014d10ba239b8f9ad073ad2d6862c24","url":"https://api.github.com/repos/meoww-07/upSol/git/trees/2c809d90e014d10ba239b8f9ad073ad2d6862c24"},"url":"https://api.github.com/repos/meoww-07/upSol/git/commits/8f2111f80dcbda34b409f893475b0715cfb2a1b5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/meoww-07/upSol/commits/8f2111f80dcbda34b409f893475b0715cfb2a1b5","html_url":"https://github.com/meoww-07/upSol/commit/8f2111f80dcbda34b409f893475b0715cfb2a1b5","comments_url":"https://api.github.com/repos/meoww-07/upSol/commits/8f2111f80dcbda34b409f893475b0715cfb2a1b5/comments","author":{"login":"meoww-07","id":211807091,"node_id":"U_kgDODJ_rcw","avatar_url":"https://avatars.githubusercontent.com/u/211807091?v=4","gravatar_id":"","url":"https://api.github.com/users/meoww-07","html_url":"https://github.com/meoww-07","followers_url":"https://api.github.com/users/meoww-07/followers","following_url":"https://api.github.com/users/meoww-07/following{/other_user}","gists_url":"https://api.github.com/users/meoww-07/gists{/gist_id}","starred_url":"https://api.github.